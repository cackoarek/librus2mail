# Plik konfiguracyjny dla aplikacji librus2mail
# Zawiera przykładowe, fikcyjne dane konfiguracyjne.

librus_users:
  - librus_login_name: "Jan Kowalski (klasa 5A)"
    librus_login: "8912345"
    librus_password: "SuperHaslo!2026"
    read_messages: true               # true pobiera treść wiadomości (UWAGA: wejście w wiadomość oznacza ją w portalu Librus jako przeczytaną)
    read_grades: true                 # true włącza monitorowanie i powiadomienia e-mail o nowych ocenach ucznia
    one_summary_message: false        # true wysyła 1 zbiorczy e-mail ze wszystkimi nowymi wpisami zamiast kilku osobnych
    do_not_send_first_parse: true     # Przy pierwszym uruchomieniu zapisuje bazę i nie wysyła starych wiadomości
    notification_receivers:
      - "rodzic.kowalski@example.com"
      - "mama.kowalska@example.com"

  # Drugie konto (np. dla młodszego dziecka):
  - librus_login_name: "Anna Kowalska (klasa 2B)"
    librus_login: "8976543"
    librus_password: "BezpieczneHaslo!456"
    read_messages: true
    read_grades: true
    one_summary_message: true         # Dla tego konta wysyłany będzie 1 zbiorczy e-mail
    do_not_send_first_parse: true
    notification_receivers:
      - "rodzic.kowalski@example.com"

# Czas oczekiwania w sekundach pomiędzy pobieraniem danych dla kolejnych kont dzieci (domyślnie: 3s)
delay_between_users_s: 3

# Czas oczekiwania w sekundach pomiędzy kolejnymi sprawdzeniami Librusa (gdy work-in-loop: true)
wait_time_s: 3600

# Tryb pracy w pętli:
# - true: skrypt działa nieprzerwanie w pętli, czekając wait_time_s sekund pomiędzy cyklami (domyślnie)
# - false: skrypt wykonuje pojedynczy przebieg i kończy działanie (idealne pod harmonogram cron)
work-in-loop: true

# Tryb przechowywania stanu (przeczytanych wiadomości, ogłoszeń i ocen):
# - "FILES": zapis stanu do plików JSON w katalogu storage/ (stan zachowywany po restarcie)
storage_type: "FILES"

# Powiadomienia o awariach i błędach (brak połączenia z portalem Librus, wygaśnięcie sesji, błąd parsowania HTML):
# - send_error_notifications: true wysyła alert e-mail do notification_receivers danego konta w razie problemów (domyślnie: true)
# - error_cooldown_s: minimalny odstęp czasu w sekundach pomiędzy wysyłkami tego samego błędu (domyślnie: 3600 = 1 godzina),
#   aby zapobiec zalewaniu skrzynki podczas trwającej awarii.
send_error_notifications: true
error_cooldown_s: 3600

# Konfiguracja wysyłki wiadomości e-mail
mail:
  login: "powiadomienia.szkola@gmail.com"
  password: "abcd efgh ijkl mnop"     # Dla Gmaila: 16-znakowe hasło aplikacji Google (App Password)
  use_gmail: true                     # true: wysyłka przez Gmail (yagmail), false: standardowy SMTP (non_gmail_settings)
  non_gmail_settings:
    port: 587
    smtp_host: "smtp.twoj-serwer.pl"
