# ==============================================================================
# Librus2mail - Wzorcowy plik zmiennych środowiskowych (.env.example)
# Skopiuj ten plik do .env: cp .env.example .env i uzupełnij wartości
# ==============================================================================

# Strefa czasowa kontenera
TZ=Europe/Warsaw

# ------------------------------------------------------------------------------
# 1. KONTO UCZNIA W LIBRUSIE (pojedyncze konto - najczęstszy przypadek)
# ------------------------------------------------------------------------------
LIBRUS_LOGIN=1234567
LIBRUS_PASSWORD=twoje_haslo_librus
LIBRUS_LOGIN_NAME=Jan Kowalski
# Odbiorcy powiadomień (jeden lub po przecinku)
LIBRUS_NOTIFICATION_RECEIVERS=rodzic@gmail.com, drugi_rodzic@example.com

# Opcjonalne flagi odczytu danych dla konta (domyślnie true)
LIBRUS_READ_MESSAGES=true
LIBRUS_READ_GRADES=true
LIBRUS_READ_TIMETABLE=true
LIBRUS_READ_SCHEDULE=true
LIBRUS_ONE_SUMMARY_MESSAGE=true

# Opcjonalny raport motywacyjny ucznia (dla ucznia)
LIBRUS_STUDENT_REPORT_ENABLED=true
LIBRUS_STUDENT_REPORT_EMAIL=uczen@gmail.com
LIBRUS_STUDENT_REPORT_TEMPLATE=kids

# ------------------------------------------------------------------------------
# 1b. DLA WIELU DZIECI (MULTI-ACCOUNT) - zamiast pojedynczego konta powyżej:
# Podaj listę w formacie JSON (odkomentuj jeśli monitorujesz więcej niż 1 konto)
# ------------------------------------------------------------------------------
# LIBRUS_USERS='[{"librus_login":"12345","librus_password":"haslo1","librus_login_name":"Jan","notification_receivers":["mama@gmail.com"]},{"librus_login":"67890","librus_password":"haslo2","librus_login_name":"Zofia","notification_receivers":["mama@gmail.com"]}]'

# ------------------------------------------------------------------------------
# 2. KONFIGURACJA POCZTY E-MAIL (WYSYŁKA)
# ------------------------------------------------------------------------------
# Wariant A: Gmail (zalecane hasło do aplikacji 16 znaków)
LIBRUS_MAIL_LOGIN=twoj_adres@gmail.com
LIBRUS_MAIL_PASSWORD=abcd efgh ijkl mnop
LIBRUS_MAIL_USE_GMAIL=true

# Wariant B: Własny serwer SMTP (odkomentuj jeśli nie używasz Gmaila)
# LIBRUS_MAIL_USE_GMAIL=false
# LIBRUS_SMTP_HOST=smtp.twoj-serwer.pl
# LIBRUS_SMTP_PORT=587

# ------------------------------------------------------------------------------
# 3. INTERAKTYWNY PANEL WEBOWY (Moduł 5)
# ------------------------------------------------------------------------------
LIBRUS_WEB_PORT=5000
LIBRUS_WEB_HOST=0.0.0.0
# Hasło zabezpieczające dostęp do panelu webowego w przeglądarce:
LIBRUS_WEB_PASSWORD=zmien_na_trudne_haslo
# Opcjonalny unikalny klucz sesji Flask (losowy ciąg znaków):
# LIBRUS_WEB_SECRET_KEY=bardzo_losowy_sekret_dla_sesji

# ------------------------------------------------------------------------------
# 4. HARMONOGRAM POBIERANIA (SCHEDULE)
# ------------------------------------------------------------------------------
# Tryb pobierania: 'daily' (o określonej porze) lub 'interval' (co X godzin)
LIBRUS_SCHEDULE_MODE=daily
LIBRUS_SCHEDULE_TIME=16:00
LIBRUS_SCHEDULE_DAYS=workdays
LIBRUS_SCHEDULE_INTERVAL_HOURS=1

# ------------------------------------------------------------------------------
# 5. ZAAWANSOWANE USTAWIENIA DEMONA
# ------------------------------------------------------------------------------
LIBRUS_STORAGE_DIR=storage
LIBRUS_WAIT_TIME_S=3600
LIBRUS_WORK_IN_LOOP=true
LIBRUS_DELAY_BETWEEN_USERS_S=10
LIBRUS_LOGIN_RETRIES=2
LIBRUS_SEND_ERROR_NOTIFICATIONS=true
