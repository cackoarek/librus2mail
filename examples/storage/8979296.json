  "messages_history": [
    {
      "id": "Podręczniki - j. niemiecki2026-09-08 14:14:14Węglarczyk  Marian (Węglarczyk  Marian) [Nauczyciel]",
      "title": "Podręczniki - j. niemiecki",
      "sender": "Węglarczyk Marian (Nauczyciel)",
      "datetime": "2026-09-08 14:14:14",
      "body": "Dzień dobry Państwu,\n\nInformuję, że w klasie 5 na lekcjach języka niemieckiego obowiązuje podręcznik i zeszyt ćwiczeń \"Wir smart 2\" wydawnictwa Klett. Uczniowie, którzy jeszcze nie odebrali zestawu z biblioteki szkolnej, proszeni są o zgłoszenie się w najbliższy czwartek.\n\nPozdrawiam serdecznie,\nMarian Węglarczyk",
      "is_unread": false
    },
    {
      "id": "Podziękowanie2026-09-11 10:12:14Wiaderko Magdalena (Wiaderko Magdalena) [Nauczyciel]",
      "title": "Podziękowanie",
      "sender": "Wiaderko Magdalena (Wychowawca)",
      "datetime": "2026-09-11 10:12:14",
      "body": "Szanowni Rodzice,\n\nSerdecznie dziękuję za zaangażowanie i pomoc w organizacji kiermaszu podręczników i przyborów szkolnych. Dzięki Państwa wsparciu udało się zebrać środki na doposażenie kącika czytelniczego w naszej sali lekcyjnej.\n\nZ wyrazami szacunku,\nMagdalena Wiaderko",
      "is_unread": false
    },
    {
      "id": "Zajęcia wych.fizycznego2026-09-15 09:24:36Staszewska Elżbieta (Staszewska Elżbieta) [Nauczyciel]",
      "title": "Zajęcia wych.fizycznego",
      "sender": "Staszewska Elżbieta (Nauczyciel)",
      "datetime": "2026-09-15 09:24:36",
      "body": "Drodzy Rodzice,\n\nPrzypominam, że ze względu na sprzyjające warunki pogodowe, lekcje wychowania fizycznego w najbliższym tygodniu będą odbywać się na boisku szkolnym (\"Orlik\"). Proszę o wyposażenie dzieci w odpowiedni strój sportowy dostosowany do temperatury zewnętrznej (dres/bluza).\n\nElżbieta Staszewska",
      "is_unread": false
    },
